{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "Edit(app/**)",
      "Write(app/**)",
      "Edit(tools/**)",
      "Write(tools/**)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx oxlint:*)",
      "Bash(node scripts/*)",
      "Bash(uv run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git checkout main -- app/*)",
      "Bash(git checkout main -- tools/*)",
      "Bash(rm app/*)",
      "Bash(git rm app/*)",
      "Bash(git mv app/*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(npm ls:*)",
      "Bash(E2E_PORT=* npx playwright test *)",
      "Bash(E2E_PORT=* npm run *)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(stat:*)",
      "Bash(wc:*)",
      "Bash(tee /dev/stderr)",
      "Bash(true)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(dir:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(curl:*)",
      "Bash(rm -rf:*)",
      "WebFetch",
      "WebSearch",
      "Edit(ops/**)",
      "Write(ops/**)",
      "Edit(../**)",
      "Write(../**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "900000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  }
}
