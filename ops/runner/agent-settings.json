    "deny": [
      "Bash(git push:*)", "Bash(git reset:*)", "Bash(git rebase:*)", "Bash(git merge:*)",
      "Bash(git branch:*)", "Bash(git worktree:*)",
      "Bash(npm install:*)", "Bash(npm i:*)", "Bash(curl:*)", "Bash(rm -rf:*)",
      "WebFetch", "WebSearch",
      "Edit(ops/**)", "Write(ops/**)", "Edit(CLAUDE.md)", "Write(CLAUDE.md)"
