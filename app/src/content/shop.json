[
  { "key": "game.shop", "vi": "Cửa hàng", "ja": "おみせやさん", "en": "The shop" },
  { "key": "shop.hello", "vi": "Chào mừng bé đến cửa hàng! Mình cùng bán hàng cho các bạn nhé!", "ja": "おみせへ ようこそ! みんなに うって あげよう!", "en": "Welcome to the shop! Let's help our friends go shopping!" },
